{
  "name": "@tahminator/pipeline",
  "version": "1.0.0",
  "description": "A collection of Bun shell scripts that can be re-used in various CICD pipelines.",
  "author": "Tahmid Ahmed",
  "repository": {
    "url": "git+https://github.com/tahminator/pipeline.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun run typecheck && bun run fmt && bun run lint && bun test",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "fmt": "oxfmt --check .",
    "fmt:fix": "oxfmt --write .",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@actions/artifact": "^6.2.1",
    "@octokit/auth-app": "^8.2.0",
    "@octokit/rest": "^22.0.1",
    "@pulumi/pulumi": "^3.258.0",
    "ansi-to-html": "^0.7.2",
    "fast-xml-builder": "^1.1.5",
    "fast-xml-parser": "^5.7.2",
    "neverthrow": "^8.2.0",
    "oxlint-tsgolint": "^7.0.2003",
    "semver": "^7.7.4",
    "xml-trueformat": "^0.9.5",
    "yaml": "^2.8.2",
    "yargs": "^18.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/semver": "^7.7.1",
    "@types/yargs": "^17.0.35",
    "globals": "^17.4.0",
    "jiti": "^2.6.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
